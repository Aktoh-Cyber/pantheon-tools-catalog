package synapse:host@0.1.0;

/// Read-only inventory of installed software + host OS facts.
///
/// `inventory.list-installed` is the heavy one (enumerates every installed
/// package); `inventory.os-info` is a cheap parse of `/etc/os-release` or
/// the equivalent on macOS / Windows.
interface inventory {
    use packages.{package-info};

    /// OS family. Mirrors the Pulumi-level tenancy detection — kept narrow
    /// on purpose so policy authors can target a small enum rather than a
    /// freeform string.
    variant os-kind {
        linux-debian,
        linux-rhel,
        linux-alpine,
        macos,
        windows,
        other(string),
    }

    record host-os {
        kind: os-kind,
        version: string,
        arch: string,
    }

    /// List every installed package the back-end can enumerate. Empty list
    /// is a valid response (e.g. no matching back-end is available).
    list-installed: func() -> list<package-info>;

    /// Report the host OS family + version + arch.
    os-info: func() -> host-os;

    /// What `list-installed` would do under this lease, without enumerating
    /// anything (#189). An empty `list-installed` cannot tell a lease that does
    /// not grant `inventory.list-installed` apart from a host with no package
    /// back-end in the node's context; this can.
    /// (WIT forbids a type and a function sharing a name, so the variant is
    /// `backend-status` and the function `inventory-status`.)
    variant backend-status {
        /// The lease does not grant `inventory.list-installed`.
        denied,
        /// No supported package back-end is visible to the node.
        no-backend,
        /// A back-end would answer. The payload names it: `apt`, `dnf`, `yum`,
        /// `apk`, `brew`, `winget`, or `registry` (Windows Uninstall keys).
        ready(string),
    }

    /// Cheap: gated on `inventory.list-installed` and audited like it, but
    /// never enumerates packages.
    inventory-status: func() -> backend-status;
}
