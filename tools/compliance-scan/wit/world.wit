// compliance-scan — Tier-2 flagship. Composes the M11 read-only providers to
// evaluate a policy bundle. Imports ONLY read-only interfaces; it can never mutate
// host state even if over-granted (packages.install/uninstall + service.* writes
// are gated per-api_id on the node regardless). 0.2.0 adds the read-only host `fs`
// interface for `config` rules (sshd_config etc.), bounded by the lease's fs_roots.
package pantheon:tools;

world compliance-scan {
    import synapse:host/inventory@0.1.0;
    import synapse:host/packages@0.1.0;
    import synapse:host/service@0.1.0;
    import synapse:host/fs@0.1.0;
}
